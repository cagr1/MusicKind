{
  "name": "musickind",
  "version": "1.0.0",
  "description": "DJ tool for music classification and set creation with desktop app support",
  "license": "GPL-3.0-or-later",
  "author": "MusicKind Team",
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "musickind": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "dev": "npm run build:web && NODE_ENV=development electron .",
    "dashboard": "node src/server.js",
    "electron": "npm run build:web && electron .",
    "electron:legacy": "MUSIC_KIND_UI=legacy electron .",
    "electron-dev": "NODE_ENV=development electron .",
    "build:web": "npm --prefix web run build",
    "build": "electron-builder",
    "test": "jest",
    "test:audio-ingestion": "node --test tests/audio-ingestion.test.js",
    "test:metadata-editor": "node --test tests/metadata-editor.test.js",
    "test:metadata-endpoint": "node --test tests/server-metadata-list.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "music-metadata": "^11.12.3"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.musickind.app",
    "productName": "MusicKind",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "ui/**/*",
      "web/dist/**/*",
      "src/**/*",
      "config/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "extraResources": [
        {
          "from": "vendor/bin/darwin-${arch}",
          "to": "bin",
          "filter": ["ffmpeg", "ffprobe", "fpcalc", "keyfinder-cli"]
        },
        {
          "from": "vendor/bin/licenses",
          "to": "bin/licenses",
          "filter": ["*"]
        }
      ],
      "category": "public.app-category.music",
      "icon": "electron/assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
